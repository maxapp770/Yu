# Replace this domain and install a valid TLS certificate before enabling.
server {
    listen 443 ssl;
    server_name store-api.example.com;
    ssl_certificate /etc/letsencrypt/live/store-api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/store-api.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    location /v1/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-HEC-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
    location = /healthz { proxy_pass http://127.0.0.1:8080; }
    location / { return 404; }
}
