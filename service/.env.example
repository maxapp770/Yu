# Generate HEC_MASTER_KEY once with: python -m hec_service.setup init
# Keep the real .env outside source archives and backups shared for review.
HEC_MASTER_KEY=REPLACE_WITH_GENERATED_KEY
HEC_DATA_DIR=/var/lib/hec-store/data
HEC_ERP_ORIGIN=https://erptest.wahatalhaitham.com
HEC_ERP_HOSTS=erptest.wahatalhaitham.com
HEC_TIMEZONE=Asia/Aden
